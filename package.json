  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "ai",
    "agents",
    "agent-framework",
    "typescript",
    "sdk",
    "tools",
    "plugins",
    "lifecycle",
    "event-bus"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
