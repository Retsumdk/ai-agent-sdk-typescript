    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "demo": "bun src/cli.ts"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Retsumdk/ai-agent-sdk-typescript.git"
  },
  "dependencies": {
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "bun-types": "^1.0.0",
    "typescript": "^5.3.0"
  }
}
